# =============================================================================
# Atome VoC Agent — environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# Inject these via your secrets manager in production (not baked into images).
# See DEPLOYMENT.md for the full deployment guide.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# Use a STRONG password and a dedicated app user; do not expose 5432 externally.
DATABASE_URL=postgresql+asyncpg://atome_app:CHANGE_ME@db-host:5432/atome_voc
DATABASE_URL_SYNC=postgresql://atome_app:CHANGE_ME@db-host:5432/atome_voc

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed origins (the frontend URL). Never use "*".
CORS_ORIGINS=https://voc.internal.example.com

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
LLM_MODEL=claude-sonnet-4-20250514

# ── Auth: Lark SSO + session (REQUIRED) ───────────────────────────────────────
# JWT_SECRET MUST be a strong random string >= 32 chars, else the app refuses to boot.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Enforce Lark SSO on all data endpoints. Keep true in production.
AUTH_ENFORCED=true
# Lark self-built app credentials (also used for Bitable sync).
LARK_APP_ID=cli_xxxxx
LARK_APP_SECRET=xxxxx
# Must match the Redirect URL registered in the Lark app console.
LARK_OAUTH_REDIRECT_URI=https://voc.internal.example.com/api/auth/lark/callback
# Where users land after login.
FRONTEND_BASE_URL=https://voc.internal.example.com
# Only these email domains may log in (comma-separated).
ALLOWED_EMAIL_DOMAINS=advancegroup.com
# Comma-separated emails that get the admin role; everyone else is viewer (read-only).
ADMIN_EMAILS=fangjie.hu@advancegroup.com
# Optional machine/ops access: send header  X-Service-Key: <this>  to call protected
# endpoints (e.g. /api/crawler/run) without SSO. Strong random value; empty = disabled.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=

# ── Crawlers / data sources (optional — enable what you use) ──────────────────
APIFY_API_TOKEN=apify_api_xxxxx
REDDIT_USER_AGENT=AtomeVoC/1.0
# JSON array of x.com cookies for authenticated X scraping (optional).
X_TWITTER_COOKIES=
# Twitter API v2 fallback (optional).
TWITTER_BEARER_TOKEN=
# Octo Agent Bitable (Facebook/TikTok). Leave blank to use the built-in defaults.
LARK_BITABLE_BASE_TOKEN=
LARK_BITABLE_TABLE_ID=
LARK_BITABLE_VIEW_ID=

# ── Alerting (optional) ───────────────────────────────────────────────────────
# Webhooks must be on the allowlist (larksuite.com / feishu.cn / slack.com).
SLACK_WEBHOOK_URL=
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxxxx
LARK_ALERT_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxxxx
SMTP_HOST=smtp.larksuite.com
SMTP_PORT=465
SMTP_USER=alerts@advancegroup.com
SMTP_PASSWORD=xxxxx
ALERT_EMAIL_FROM=alerts@advancegroup.com
ALERT_EMAIL_TO=cs-head@advancegroup.com,product-head@advancegroup.com

# ── Schedule / misc ───────────────────────────────────────────────────────────
# Daily data refresh time (Octo refreshes the Bitable ~09:00-10:00; sync after).
CRAWL_SCHEDULE_HOURS=10
CRAWL_SCHEDULE_MINUTE=30
DIGEST_HOUR=9
TZ=Asia/Manila
# Octo/Bitable is the source; set true to also run the direct Apify Reddit/X crawlers.
ENABLE_APIFY_CRAWLERS=false
